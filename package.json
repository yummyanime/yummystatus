{
    "name": "yummystatus",
    "version": "1.0.0",
    "description": "A simple service for monitoring website availability via HTTP requests using the globalping.io API.",
    "private": true,
    "type": "module",
    "workspaces": [
        "db",
        "api",
        "collector",
        "bot",
        "site"
    ],
    "scripts": {
        "dev": "docker compose up -d --build --wait --remove-orphans && echo \"\nСайт: http://localhost:15173   API: http://localhost:13000\n\"",
        "build": "bun run --filter '@yummystatus/site' build",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check .",
        "format": "biome format --write .",
        "db:generate": "bun run --filter '@yummystatus/db' db:generate",
        "prepare": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "bun run typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.0",
        "bun-types": "^1.3.0",
        "simple-git-hooks": "^2.11.1",
        "typescript": "~5.8.3"
    }
}
